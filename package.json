{
  "name": "md-viewer",
  "version": "1.0.0",
  "private": true,
  "description": "MD Viewer - Debian Desktop-App zum Anzeigen von Markdown-Dateien (GTK3 + WebKit2GTK)",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/tikogaming1/md-viewer.git"
  },
  "scripts": {
    "vendor": "node scripts/vendor-assets.mjs",
    "bundle": "node scripts/build-web.mjs",
    "build": "npm run vendor && npm run bundle",
    "test": "node --test tests/js/",
    "test:verbose": "node --test --test-reporter=spec tests/js/",
    "icons": "python3 scripts/make_icons.py",
    "preview": "node scripts/build-preview.mjs"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "dompurify": "^3.4.17",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "marked": "^18.1.1",
    "marked-alert": "^2.1.2",
    "marked-footnote": "^1.4.0",
    "marked-gfm-heading-id": "^4.1.4",
    "marked-highlight": "^2.2.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3"
  }
}
